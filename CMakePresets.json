{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64, Visual Studio 2022, AVX2 + FMA",
      "description": "Optimized MSVC build for any x64 CPU with AVX2 (Intel Haswell / AMD Excavator, 2013, or newer).",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "RAG_ARCH": "x86-64-v3" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-msvc-scalar",
      "inherits": "windows-msvc",
      "displayName": "Windows x64, Visual Studio 2022, no AVX2 (runs on any x64 CPU)",
      "binaryDir": "${sourceDir}/build-scalar",
      "cacheVariables": { "RAG_ARCH": "x86-64" }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-scalar-release", "configurePreset": "windows-msvc-scalar", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "windows-scalar-release",
      "configurePreset": "windows-msvc-scalar",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    }
  ]
}
